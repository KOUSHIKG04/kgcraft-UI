{
  "name": "kgcraft-ui-cli",
  "version": "0.2.0",
  "description": "Install editable KGCraft UI components in React projects",
  "type": "module",
  "bin": {
    "kgcraft-ui": "./dist/index.js",
    "my-ui": "./dist/index.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "node ../../scripts/build-registry.mjs && tsup src/index.ts --format esm --dts",
    "check-types": "tsc --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.3",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fs-extra": "^11.2.0",
    "kleur": "^4.1.5",
    "ora": "^8.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  }
}
